#! /usr/bin/env python
# encoding: utf-8

def configure(conf):
    if conf.env.DEST_OS != 'android' or conf.env.DEST_CPU not in ('aarch64', 'arm64'):
        conf.fatal('The Cefrium frame adapter requires Android arm64')


def build(bld):
    env = bld.env.derive()
    env.append_value('CXXFLAGS', ['-std=c++17', '-fexceptions'])
    env.cxxshlib_PATTERN = 'lib%s.so'
    bld.shlib(target='html_cefrium', name='html_cefrium',
              source=['cefrium_frame.cpp', 'cefrium_runtime.cpp'], env=env,
              install_path=bld.env.LIBDIR)
